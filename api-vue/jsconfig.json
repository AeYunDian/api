{
    "compilerOptions": {
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*.js",
        "src/**/*.ts",
        "src/**/*.vue",
        "src/**/*.md"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "../api-assets"
    ]
}